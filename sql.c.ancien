#include <stdio.h>
#include <ncurses.h>
#include <string.h>

#define WIDTH 30
#define HEIGHT 10 

int startx, starty;
char str [ 30 ];
char* choix[] =
{ 
	"Afficher tous",
	"Afficher un individu",
	"Choix 3",
	"Choix 4",
	"Fin",
};
int n_choix = sizeof(choix) / sizeof(char *);

void print_menu(WINDOW* menu_win, int highlight);
void effacer_ecran ( int );
void afficher_resultat ( int, char [] );

extern uint64_t connexion ( void );
extern uint64_t traitement_requete ( uint64_t, char*, char* );
extern void deconnexion ( uint64_t );

int main ( void )
{
	uint64_t mysql;
	char requete [ 200 ];
	char resultat [ 200 ];
	WINDOW* menu_win;
	int highlight = 1;
	int choice, c;
	int fin = FALSE;

	mysql = connexion ( );
	if ( !mysql ) return 1;
	initscr ( );
	clear ( );
	noecho ( );
	cbreak ( );			// Line buffering disabled. pass on everything
	startx = (80 - WIDTH) / 2;
	starty = (24 - HEIGHT) / 2;
	menu_win = newwin ( HEIGHT, WIDTH, starty, startx );
	keypad ( menu_win, TRUE );
	mvprintw ( 0, 0, "Utilise les flèches vers le haut et vers le bas ; appuie sur la touche entrée pour valider" );
	curs_set ( 0 );		// invisible
	refresh ( );
	do
	{
		choice = 0;
		print_menu ( menu_win, highlight );
		while ( TRUE )
		{
			c = wgetch ( menu_win );
			switch(c)
			{	case KEY_UP:
					if(highlight == 1) highlight = n_choix;
					else --highlight;
					break;
				case KEY_DOWN:
					if(highlight == n_choix) highlight = 1;
					else ++highlight;
					break;
				case 0x0A:			// 0x0A = enter key
					choice = highlight;
					break;
				default:
					break;
			}
			print_menu ( menu_win, highlight );
			if ( choice ) break;
		}
		effacer_ecran ( 17 );
		switch ( choice )
		{
			case 1:
				if ( traitement_requete ( mysql, "select lib_nom, lib_prenom, lib_naissance from individu, nom, prenom, naissance where nom=id_nom and prenom=id_prenom and naissance=id_naissance", resultat ) )
					afficher_resultat ( 18, resultat );
				else
				{
					mvprintw ( 18, 0, "Pas de résultat." );
					refresh ( );
				}
				break;
			case 2:
				curs_set ( 1 );		// visible
				mvprintw ( 17, 10, "Nom : " );
				clrtoeol ( );
				echo ( );
				getstr ( str );
				noecho ( );
				curs_set ( 0 );		// invisible
				strcpy ( requete, "select lib_nom, lib_prenom, lib_naissance from individu, nom, prenom, naissance where nom=id_nom and prenom=id_prenom and naissance=id_naissance and lib_nom like '" );
				strcat ( requete, str );
				strcat ( requete, "'" );
				if ( traitement_requete ( mysql, requete, resultat ) ) afficher_resultat ( 18, resultat );
				else
				{
					mvprintw ( 18, 0, "Pas de résultat." );
					refresh ( );
				}
				break;
			case 5:
				fin = TRUE;
				break;
			default:
				mvprintw ( 23, 0, "Choix n° %d\n", choice );
				clrtoeol ( );
				refresh ( );
				break;
		}
	} while ( !fin );
	endwin();
	deconnexion ( mysql );
	return 0;
}

void effacer_ecran ( int y )
{
	do
	{
		move ( y++, 0 );
		clrtoeol ( );
	} while ( y < 30 );
	refresh ( );
}

void afficher_resultat ( int y, char resultat [ ] )
{
	int p = 0;
	char r;
	
	if ( resultat [ p++ ] == '{' )
	{
		mvprintw ( y++, 0, "Nom\t\tPrénom\t\tNaissance" );
		do
		{
			r = resultat [ p++ ];
			switch ( r )
			{
				case '[':
					move ( y++, 0 );
					break;
				case ']':
					printw ( "\t<fin>" );
					clrtoeol ( );
					break;
				case ',':
					printw ( "\t" );
					break;
				default:
					printw ( "%c", r );
			}	
		} while ( resultat [ p ] != '}' );
	}
	else printw ( "Erreur de format du résultat" );
	refresh ( );
}

void print_menu(WINDOW *menu_win, int highlight)
{
	int x, y, i;	

	x = 2;
	y = 2;
	box(menu_win, 0, 0);
	for(i = 0; i < n_choix; ++i)
	{	if(highlight == i + 1) /* High light the present choice */
		{	wattron(menu_win, A_REVERSE); 
			mvwprintw(menu_win, y, x, "%s", choix[i]);
			wattroff(menu_win, A_REVERSE);
		}
		else mvwprintw(menu_win, y, x, "%s", choix[i]);
		++y;
	}
	wrefresh(menu_win);
}
